# Parameter sweep (APPEND wave 6c): first push past the existing De=0.50
# ceiling. Vatsal (2026-08-17): bias new datapoints into 0.1<De<0.4 but
# fill outside that band too. This is the outside-band contribution:
# a single new De=0.6 column across the full round We axis. Exploratory --
# nothing in the existing De=0.43/0.46/0.50 data suggests instability at
# this De, so kept at the same resolution/domain as its De=0.5 neighbours
# rather than pre-emptively widening the domain.
#
# 11 cases this config x 2 grids (fixedBeta + fixedEc) = 22 new simulations.
#
# Non-destructive append via CASE_OFFSET=306, following directly after
# wave 6b (cases 323-344) -> cases 345-355.

MODE = fixedBeta

SWEEP_WE = 10 15 20 25 30 35 40 45 50 55 60
SWEEP_DE = 0.6

# fixed rheology
Ohs = 0.003        # solvent (water) Ohnesorge number
beta = 0.1         # solvent fraction  ->  Oh_total = Ohs/beta = 0.03

# fixed numerics / forcing
MAXlevel = 11
Ldomain = 8.0
tmax = 20.0
DTmax = 2e-5
Bo = 1.0

# contact-line switching (paper protocol: ramp 160 -> 60 over t in [8,9])
thetaInit = 160.0
thetaE = 60.0
ttheta = 8.0
thetaRate = 100.0
