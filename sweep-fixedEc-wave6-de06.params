# Parameter sweep (APPEND wave 6c): first push past the existing De=0.50
# ceiling. fixedEc counterpart of sweep-fixedBeta-wave6-de06.params -- see
# that file for rationale.
#
# 11 cases this config x 2 grids (fixedBeta + fixedEc) = 22 new simulations.
#
# Non-destructive append via CASE_OFFSET=306, following directly after
# wave 6b (cases 323-344) -> cases 345-355.

MODE = fixedEc

SWEEP_WE = 10 15 20 25 30 35 40 45 50 55 60
SWEEP_DE = 0.6

# fixed rheology
Ohs = 0.003        # solvent (water) Ohnesorge number
Ec = 0.1           # fixed elasto-capillary number

# fixed numerics / forcing
MAXlevel = 11
Ldomain = 8.0
tmax = 20.0
DTmax = 2e-5
Bo = 1.0

# contact-line switching (paper protocol: ramp 160 -> 60 over t in [8,9])
thetaInit = 160.0
thetaE = 60.0
ttheta = 8.0
thetaRate = 100.0
